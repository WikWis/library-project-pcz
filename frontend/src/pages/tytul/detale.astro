---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitleDetails from "../../components/title/TitleDetails.astro";
import DangerAlert from "../../components/alert/DangerAlert.astro";
import ConfirmRemoveAlert from "../../components/alert/ConfirmRemoveAlert.astro";
---

<BaseLayout>
    <h1>Tytuły</h1>
    <p>Na tej stronie znajdziesz listę z tytułów dostępnych w naszym systemie</p>

    <div class="container">

        <div id="not-found-message" class="row" hidden>
            <h1>Nie znaleziono Tytułu!</h1>
        </div>

        <DangerAlert id="title-danger-alert" message="Nie udało sie usunąć Tytułu." isHidden={true}/>

        <div id="content">
            <div class="row">
                <TitleDetails/>
            </div>
        </div>

        <div class="row ">
            <div class="d-flex gap-2 mt-2">
                <a id="edit-button" class="btn btn-success" href="/tytul/edytuj?id=1">Edytuj Autora</a>
                <a type="button" class="btn btn-danger" data-bs-toggle="modal"
                   data-bs-target="#confirmRemoveModal">Usuń</a>
            </div>
        </div>

        <ConfirmRemoveAlert message="Czy na pewno chcesz usunąć ten tytuł?"/>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/tytul/detale.ts";

    init()
</script>