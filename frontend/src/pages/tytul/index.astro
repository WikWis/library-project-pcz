---
import NavigationButtons from "../../components/navigation/NavigationButtons.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitleTable from "../../components/table/TitleTable.astro";
---
<BaseLayout>
    <h1>Tytuły</h1>
    <p>Na tej stronie znajdziesz listę z tytułów dostępnych w naszym systemie</p>

    <div class="container">

        <div class="row">
            <TitleTable titleTableId="title-table"/>
        </div>

        <div class="row">
            <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
        </div>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/tytul";

    init()
</script>