---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublisherDetails from "../../components/publisher/PublisherDetails.astro";
import DangerAlert from "../../components/alert/DangerAlert.astro";
import ConfirmRemoveAlert from "../../components/alert/ConfirmRemoveAlert.astro";
---

<BaseLayout>
    <h1>Wydawcy</h1>
    <p>Na tej stronie znajdziesz listę z wydawców zawartych w naszym systemie</p>

    <div class="container">

        <div id="not-found-message" class="row" hidden>
            <h1>Nie znaleziono autora!</h1>
        </div>

        <DangerAlert id="publisher-danger-alert" message="Nie udało sie usunąć wydawnictwa." isHidden={true}/>

        <div id="content">
            <div class="row">
                <PublisherDetails/>
            </div>
        </div>

        <div class="row ">
            <div class="d-flex gap-2 mt-2">
                <a id="edit-button" class="btn btn-success" href="/wydawca/edytuj?id=1">Edytuj Wydawcę</a>
                <a type="button" class="btn btn-danger" data-bs-toggle="modal"
                   data-bs-target="#confirmRemoveModal">Usuń</a>
            </div>
        </div>

        <ConfirmRemoveAlert message="Czy na pewno chcesz usunąć to wydawnictwo?"/>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/wydawca/detale.ts";

    init()
</script>