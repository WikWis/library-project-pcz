---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PublisherDetails from "../../components/publisher/PublisherDetails.astro";
---

<BaseLayout>
    <h1>Wydawcy</h1>
    <p>Na tej stronie znajdziesz listę z wydawców zawartych w naszym systemie</p>

    <div class="container">

        <div id="not-found-message" class="row" hidden>
            <h1>Nie znaleziono autora!</h1>
        </div>

        <div id="content">

            <div class="row">
                <PublisherDetails/>
            </div>

        </div>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/wydawca/detale.ts";

    init()
</script>