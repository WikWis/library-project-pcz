---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavigationButtons from "../../components/navigation/NavigationButtons.astro";
import PublisherTable from "../../components/publisher/PublisherTable.astro";
---

<BaseLayout>
    <h1>Wydawcy</h1>
    <p>Na tej stronie znajdziesz listę z wydawców zawartych w naszym systemie</p>

    <div class="container">

        <div class="row">
            <PublisherTable publisherTableId="publisher-table"/>
        </div>

        <div class="row">
            <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
        </div>

        <div class="row">
            <div class="col mt-3">
                <a class="btn btn-success" href="wydawca/utworz">Dodaj Wydawce</a>
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/wydawca";

    init()
</script>