---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavigationButtons from "../../components/navigation/NavigationButtons.astro";
import PieceTable from "../../components/table/PieceTable.astro";
---

<BaseLayout>
    <h1>Egzemplarze</h1>
    <p>Na tej stronie znajdziesz listę z dostępnymi egzemplarzami w naszym systemie</p>

    <div class="container">

        <div class="row">
            <PieceTable pieceTableId="pieces-table"/>
        </div>

        <div class="row">
            <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
        </div>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/egzemplarz";

    init()
</script>
