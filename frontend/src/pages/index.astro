---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout>
    <h1>Strona główna</h1>

    <p>Witaj na stronie głównej biblioteki!</p>
</BaseLayout>

<!--// For testing delete in future-->
<script>
    import {AuthorService} from "../services/author-service.ts";
    import {TitleService} from "../services/title-service.ts";
    import {PieceService} from "../services/piece-service.ts";
    import {PieceState} from "../dto/piece/piece-status.ts";
    import {PieceStatus} from "../dto/piece/piece-state.ts";


    // Author Service
    let authorService: AuthorService = new AuthorService();

    console.log(await authorService.Index())
    console.log(await authorService.Index(undefined, 3, 1))
    console.log(await authorService.Details(3123123121))
    console.log(await authorService.Create(
        {
            Name: "dasdas",
            Surname: "dasdasdas",
        }
    ))
    console.log(await authorService.Update(1,
        {
            AuthorId: 1,
            Name: "dasdas",
            Surname: "dasdasdas",
        }
    ))
    console.log(await authorService.Delete(2034));


    // Title Service
    let titleService: TitleService = new TitleService();

    console.log(await titleService.Index())
    console.log(await titleService.Index(undefined, 3, 1))
    console.log(await titleService.Details(3123123121))
    console.log(await titleService.Create({
        Name: 'Wiedźmin: Ostatnie życzenie',
        DateOfPublishing: '1993-11-01',
        ISBN: 9788375780635,
        Genres: ['Fantasy', 'Adventure'],
        Authors: [
            {
                AuthorId: 1,
                Name: 'Andrzej',
                Surname: 'Sapkowski',
            },
        ],
        Publisher: {
            PublisherId: 2,
            Name: 'superNOWA',
        },
    }))
    console.log(await titleService.Update(1, {
        TitleId: 1,
        Name: 'Wiedźmin: Ostatnie życzenie',
        DateOfPublishing: '1993-11-01',
        ISBN: 9788375780635,
        Genres: ['Fantasy', 'Adventure'],
        Authors: [
            {
                AuthorId: 1,
                Name: 'Andrzej',
                Surname: 'Sapkowski',
            },
        ],
        Publisher: {
            PublisherId: 1,
            Name: 'superNOWA',
        },
    }))
    console.log(await titleService.Delete(1042));

    // Piece Service
    let pieceService: PieceService = new PieceService();
    console.log(await pieceService.Index())
    console.log(await pieceService.Details(2))
    console.log(await pieceService.Create(2004, {
        TitleId: 1,
        State: PieceState.Good,
        Status: PieceStatus.Borrowed
    }))
    console.log(await pieceService.Update(2, {
            PieceId: 2,
            State: PieceState.Good,
            Status: PieceStatus.Free
        }
    ))
    console.log(await pieceService.Delete(1002))


</script>