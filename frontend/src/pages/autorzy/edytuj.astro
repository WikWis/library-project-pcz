---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SuccessAlert from "../../components/alert/SuccessAlert.astro";
import DangerAlert from "../../components/alert/DangerAlert.astro";
import AuthorForm from "../../components/author/AuthorForm.astro";
---
<BaseLayout>
    <h1>Autorzy</h1>
    <p>Strona poświęcona autorom.</p>

    <SuccessAlert id="author-success-alert" message="Udało sie zapisać autora" isHidden={true}/>
    <DangerAlert id="author-danger-alert" message="Nie udało sie zapisać autora." isHidden={true}/>

    <div id="not-found-message" class="row" hidden>
        <h1>Nie znaleziono autora!</h1>
    </div>

    <div id="content">
        <AuthorForm buttonMessage="Edytuj"/>
    </div>

</BaseLayout>

<script>
    import {init} from "../../scripts/pages/autorzy/edytuj.ts";

    init()
</script>