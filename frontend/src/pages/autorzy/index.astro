---
import BaseLayout from "../../layouts/BaseLayout.astro";
import NavigationButtons from "../../components/navigation/NavigationButtons.astro";
import AuthorTable from "../../components/author/AuthorTable.astro";
---

<BaseLayout>
    <h1>Autorzy</h1>
    <p>Strona poświęcona autorom.</p>

    <div class="container">

        <div class="row">
            <AuthorTable authorTableId="authors-table"/>
        </div>

        <div class="row">
            <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
        </div>

        <div class="row ">
            <div class="col mt-3">
                <a class="btn btn-success" href="autorzy/utworz">Dodaj Autora</a>
            </div>
        </div>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/autorzy";

    init()
</script>