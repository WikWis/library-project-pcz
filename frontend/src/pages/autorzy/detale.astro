---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TitleTable from "../../components/table/TitleTable.astro";
import NavigationButtons from "../../components/navigation/NavigationButtons.astro";
---

<BaseLayout>
    <div class="container">

        <div id="not-found-message" class="row" hidden>
            <h1>Nie znaleziono autora!</h1>
        </div>

        <div id="content">

            <div class="row">
                <div id="author-data"></div>
            </div>

            <div class="row">
                <h3>Książki tego autora:</h3>
                <TitleTable titleTableId="titles-table"/>
            </div>

            <div class="row">
                <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
            </div>

        </div>

    </div>
</BaseLayout>

<script>
    import {init} from "../../scripts/pages/autorzy/detale.ts";

    init()
</script>