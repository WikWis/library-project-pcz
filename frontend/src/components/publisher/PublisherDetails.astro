---

import NavigationButtons from "../navigation/NavigationButtons.astro";---
<div class="container-fluid mt-4 px-4">
    <div class="card shadow-sm w-100">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Szczegóły wydawcy</h4>
        </div>

        <div class="card-body p-4">

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>ID wydawcy:</strong>
                    <span id="publisher-id"></span>
                </div>

                <div class="col-md-6">
                    <strong>Nazwa:</strong>
                    <span id="publisher-name"></span>
                </div>
            </div>

            <hr>

            <div class="mb-3">
                <strong>Opublikowane tytuły:</strong>

                <div id="publisher-titles-list" class="mt-3"></div>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <NavigationButtons previousButtonId="previous-button" nextButtonId="next-button"/>
            </div>

        </div>
    </div>
</div>