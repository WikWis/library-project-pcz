---

---
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Szczegóły tytułu</h4>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>ID:</strong>
                    <span id="title-id"></span>
                </div>
                <div class="col-md-6">
                    <strong>Nazwa:</strong>
                    <span id="title-name"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Data publikacji:</strong>
                    <span id="title-publishing-date"></span>
                </div>
                <div class="col-md-6">
                    <strong>ISBN:</strong>
                    <span id="title-isbn"></span>
                </div>
            </div>

            <hr>

            <div class="mb-3">
                <strong>Gatunki:</strong>
                <div id="title-genres" class="mt-2">
                </div>
            </div>

            <div class="mb-3">
                <strong>Autorzy:</strong>
                <ul id="title-authors" class="list-group mt-2">
                </ul>
            </div>

            <div class="mb-3">
                <strong>Wydawca:</strong>
                <div id="title-publisher" class="mt-2">
                </div>
            </div>
        </div>
    </div>
</div>