---

import NavigationButtons from "../navigation/NavigationButtons.astro";---
<div class="container-fluid mt-4 px-4">
    <div class="card shadow-sm w-100">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Szczegóły autora</h4>
        </div>

        <div class="card-body p-4">
            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>ID autora:</strong>
                    <span id="author-id"></span>
                </div>

                <div class="col-md-4">
                    <strong>Imię:</strong>
                    <span id="author-name"></span>
                </div>

                <div class="col-md-4">
                    <strong>Nazwisko:</strong>
                    <span id="author-surname"></span>
                </div>
            </div>

            <hr>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <strong>Opublikowane tytuły:</strong>
                    <span id="author-titles-length" class="badge bg-primary">
                    </span>
                </div>

                <div id="author-titles-list"></div>

            </div>

            <NavigationButtons nextButtonId="next-button" previousButtonId="previous-button"/>

        </div>
    </div>
</div>