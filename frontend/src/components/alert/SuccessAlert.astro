---
interface Props {
    id: string,
    message: string,
    isHidden: boolean,
}

const {
    id,
    message,
    isHidden
} = Astro.props
---
<div id={id} class:list={
    [
        "alert",
        "alert-success",
        "alert-dismissible",
        "fade",
        "show",
        {"d-none": isHidden}
    ]
} role="alert">
    {message}
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>